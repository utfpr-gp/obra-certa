# PRODUCAO: copie para .env.production na RAIZ, nunca para dentro da imagem.
# Nao comite .env ou .env.production. Preencha somente no servidor.
# Apenas o dominio, sem https://, porta ou caminho.
APP_DOMAIN=

# Aurora Express PostgreSQL 17, com gateway gerenciado e autenticacao IAM.
# Use o endpoint GRAVADOR do cluster, e nao o endpoint de leitura.
# Use o endpoint fornecido pelo RDS, sem protocolo ou porta.
RDS_HOST=
RDS_DATABASE=obracerta
RDS_USERNAME=obracerta
AWS_REGION=us-east-2
# NAO HA SENHA DE BANCO: o perfil IAM da EC2 autentica a API automaticamente.
# Consulte docs/deploy-aws.md para criar o usuario de banco e vincular o perfil.
# Gere outro segredo: openssl rand -hex 48
JWT_SECRET=

# Remetente autorizado no provedor. SMTP com autenticacao e STARTTLS na porta 587.
# Gmail exige senha de aplicativo; nao use a senha normal da conta.
MAIL_FROM=
SMTP_HOST=smtp.gmail.com
SMTP_USERNAME=
SMTP_PASSWORD=

# Comprovantes: bucket PRIVADO Supabase S3, separado do desenvolvimento.
# O banco RDS armazena metadados, nao os arquivos dos comprovantes.
RECEIPT_STORAGE_ENDPOINT=
RECEIPT_STORAGE_BUCKET=
RECEIPT_STORAGE_REGION=
RECEIPT_STORAGE_ACCESS_KEY=
RECEIPT_STORAGE_SECRET_KEY=
