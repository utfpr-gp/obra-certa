# 🐘 Exemplo de Conexão com o Banco de Dados Local
# Copie este arquivo, renomeie para .env e coloque suas senhas reais.
DATASOURCE_URL=jdbc:postgresql://localhost:5432/obracerta

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=obracerta
# Supabase Storage S3: fill these fields manually in the root .env.
# See docs/supabase-storage.md. Use a private development bucket; production has separate credentials.
RECEIPT_STORAGE_BUCKET=expense-receipts-dev
# Direct endpoint: https://<project-ref>.storage.supabase.co/storage/v1/s3
RECEIPT_STORAGE_ENDPOINT=
# Copy the region from the project's S3 configuration panel; do not infer it.
RECEIPT_STORAGE_REGION=
# Generate S3 Access Key ID / Secret Access Key in the panel (not anon/service_role keys).
RECEIPT_STORAGE_ACCESS_KEY=
RECEIPT_STORAGE_SECRET_KEY=
RECEIPT_STORAGE_PATH_STYLE=true

# Producao (SPRING_PROFILES_ACTIVE=prod). Sem JWT_SECRET, SPRING_DATASOURCE_* e
# CORS_ALLOWED_ORIGINS a aplicacao se recusa a subir. Veja docs/architecture.md (secao 8).
# SPRING_PROFILES_ACTIVE=prod
# SPRING_DATASOURCE_URL=jdbc:postgresql://<host>/<db>?sslmode=require
# SPRING_DATASOURCE_USERNAME=
# SPRING_DATASOURCE_PASSWORD=
# JWT_SECRET=           # gere com: openssl rand -base64 48
# CORS_ALLOWED_ORIGINS=https://seu-frontend.example.com
# PORT=8080             # definida automaticamente por plataformas como o Render
