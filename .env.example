# Configuração de exemplo do ObraCerta
# Para AWS + RDS, use deploy/.env.example e docs/deploy-aws.md.
# Copie este arquivo para .env na raiz e preencha os campos necessários.
# Este modelo pode ser versionado. As credenciais reais ficam no .env,
# ignorado pelo Git. Use os valores abaixo apenas no desenvolvimento local.
# O Spring lê o arquivo como properties; mantenha os valores sem aspas.

# PostgreSQL local. O Compose usa estes campos para criar o banco e conectar a API.
# A API executada diretamente usa localhost:5432 no perfil dev.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=obracerta

# Comprovantes e XML de NF-e — armazenamento privado compatível com S3.
# Preencha conforme docs/supabase-storage.md. Use credenciais próprias por ambiente.
RECEIPT_STORAGE_BUCKET=expense-receipts-dev
# Endpoint do projeto, por exemplo https://<projeto>.storage.supabase.co/storage/v1/s3
RECEIPT_STORAGE_ENDPOINT=
# Copie a região exibida no painel S3 do provedor.
RECEIPT_STORAGE_REGION=
# Gere o par Access Key ID / Secret Access Key no painel S3 do provedor.
RECEIPT_STORAGE_ACCESS_KEY=
RECEIPT_STORAGE_SECRET_KEY=
RECEIPT_STORAGE_PATH_STYLE=true

# Produção — preencha e descomente os campos abaixo.
# Além deles, substitua os valores FRONTEND_URL, MAIL_FROM e SMTP_* mais abaixo.
# Sem as variáveis obrigatórias preenchidas, a API pode falhar na inicialização.
# No Compose atual, SPRING_DATASOURCE_* são definidos pelo docker-compose.yml;
# para usar um banco externo, ajuste também esse arquivo.
# SPRING_PROFILES_ACTIVE=prod
# SPRING_DATASOURCE_URL=jdbc:postgresql://<host>/<db>?sslmode=require
# SPRING_DATASOURCE_USERNAME=
# SPRING_DATASOURCE_PASSWORD=
# Gere um segredo exclusivo, por exemplo com openssl rand -base64 48.
# JWT_SECRET=
# Origens autorizadas no CORS, separadas por vírgula.
# CORS_ALLOWED_ORIGINS=https://seu-frontend.example.com
# Se o banco usar um pooler, informe a URL JDBC direta para as migrations.
# FLYWAY_URL=jdbc:postgresql://<host-direto>/<db>?sslmode=require
# PORT=8080

# Recuperação de senha — valores para desenvolvimento com capturador SMTP local.
# O capturador deve estar em execução; ele não é iniciado automaticamente.
# FRONTEND_URL é o endereço do frontend usado nos links enviados por e-mail.
FRONTEND_URL=http://localhost:4200
# Remetente exibido no e-mail.
MAIL_FROM=ObraCerta <noreply@localhost>
# Em Docker, localhost é o próprio container da API. Use o nome do serviço SMTP
# na rede Docker ou um endereço do host acessível pelo container.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_AUTH=false
SMTP_STARTTLS=false
SMTP_USERNAME=
SMTP_PASSWORD=
# Para produção, substitua FRONTEND_URL pela URL HTTPS pública da aplicação,
# MAIL_FROM pelo remetente autorizado no provedor e SMTP_HOST pelo servidor real.
# Defina SMTP_PORT=587, SMTP_AUTH=true, SMTP_STARTTLS=true e preencha
# SMTP_USERNAME e SMTP_PASSWORD com as credenciais SMTP (ou senha de aplicativo).
# O perfil prod exige autenticação e STARTTLS.
